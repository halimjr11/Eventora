<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Eventora" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="android:textColorPrimary">@color/md_theme_light_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_light_onBackground</item>
        <item name="android:statusBarColor">@color/md_theme_light_primary</item>
        <item name="android:navigationBarColor">@color/md_theme_light_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Jakarta.HeadlineSmall</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Jakarta.TitleMedium</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Jakarta.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Jakarta.LabelLarge</item>
    </style>

    <style name="TextAppearance.Jakarta.HeadlineSmall" parent="@style/TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Jakarta.TitleMedium" parent="@style/TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Jakarta.BodyMedium" parent="@style/TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.Jakarta.LabelLarge" parent="@style/TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <style name="Theme.Eventora" parent="Base.Theme.Eventora" />
</resources>